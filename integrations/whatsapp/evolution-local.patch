index 0000000..1e41622
--- /dev/null
+++ b/pkg/instance/service/reconnect_test.go
@@ -0,0 +1,36 @@
+package instance_service
+
+import (
+	"errors"
+	"testing"
+
+	instance_model "github.com/evolution-foundation/evolution-go/pkg/instance/model"
+	whatsmeow_service "github.com/evolution-foundation/evolution-go/pkg/whatsmeow/service"
+)
+
+type reconnectBackend struct {
+	whatsmeow_service.WhatsmeowService
+	called string
+	err    error
+}
+
+func (b *reconnectBackend) ReconnectClient(id string) error {
+	b.called = id
+	return b.err
+}
+
+func TestReconnectWithoutRuntimeClient(t *testing.T) {
+	for _, wantErr := range []error{nil, errors.New("backend unavailable")} {
+		backend := &reconnectBackend{err: wantErr}
+		service := instances{whatsmeowService: backend}
+		// No client pointer or StartInstance implementation exists: an active-client
+		// precondition would panic instead of reaching the reconnect backend.
+		err := service.Reconnect(&instance_model.Instance{Id: "saved-instance"})
+		if backend.called != "saved-instance" {
+			t.Fatalf("reconnect did not receive the saved instance: %q", backend.called)
+		}
+		if !errors.Is(err, wantErr) {
+			t.Fatalf("got %v, want %v", err, wantErr)
+		}
+	}
+}
