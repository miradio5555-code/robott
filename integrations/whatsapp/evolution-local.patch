+// Shared across reconnects and instances: device stores retain this pool.
+// Creating a new pool for every QR refresh leaks database connections.
+func openDeviceStore(ctx context.Context, dialect, address string, log waLog.Logger) (*sqlstore.Container, error) {
+	db, err := sql.Open(dialect, address)
+	if err != nil {
+		return nil, err
+	}
+	db.SetMaxOpenConns(10)
+	db.SetMaxIdleConns(2)
+	db.SetConnMaxIdleTime(time.Minute)
+	if dialect == "sqlite" {
+		db.SetMaxOpenConns(1)
+	}
+	c := sqlstore.NewWithDB(db, dialect, log)
+	if err := c.Upgrade(ctx); err != nil {
+		_ = c.Close()
+		return nil, err
+	}
+	return c, nil
+}
+
+type sharedDeviceStore struct {
+	mu        sync.Mutex
+	container *sqlstore.Container
+}
+
+func (s *sharedDeviceStore) get(open func() (*sqlstore.Container, error)) (*sqlstore.Container, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.container != nil {
+		return s.container, nil
+	}
+	c, err := open()
+	if err == nil {
+		s.container = c
+	}
+	return c, err
+}
+
