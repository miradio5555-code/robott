new file mode 100644
index 0000000..730af26
--- /dev/null
+++ b/pkg/whatsmeow/service/device_store_test.go
@@ -0,0 +1,40 @@
+package whatsmeow_service
+
+import (
+	"errors"
+	"go.mau.fi/whatsmeow/store/sqlstore"
+	"sync"
+	"testing"
+)
+
+func TestDeviceStorePoolReusedAcrossConcurrentReconnects(t *testing.T) {
+	pool := &sharedDeviceStore{}
+	want := &sqlstore.Container{}
+	calls := 0
+	var wg sync.WaitGroup
+	for i := 0; i < 50; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			got, err := pool.get(func() (*sqlstore.Container, error) { calls++; return want, nil })
+			if err != nil || got != want {
+				t.Error("wrong pool")
+			}
+		}()
+	}
+	wg.Wait()
+	if calls != 1 {
+		t.Fatalf("opened %d pools", calls)
+	}
+}
+func TestDeviceStorePoolRetriesFailedOpen(t *testing.T) {
+	pool := &sharedDeviceStore{}
+	if _, err := pool.get(func() (*sqlstore.Container, error) { return nil, errors.New("temporary") }); err == nil {
+		t.Fatal("expected error")
+	}
+	want := &sqlstore.Container{}
+	got, err := pool.get(func() (*sqlstore.Container, error) { return want, nil })
+	if err != nil || got != want {
+		t.Fatal("failed to retry")
+	}
+}
